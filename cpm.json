{
  "name": "pp",
  "version": "1.1.0",
  "description": "ProjectPlatform - Windows project management CLI (PP)",
  "type": "executable",
  "main": "src/main.cpp",
  "sources": [
    "src/main.cpp",
    "src/cli/commands.cpp",
    "src/cli/parser.cpp",
    "src/core/update.cpp",
    "src/util/version.cpp",
    "src/core/secrets.cpp",
    "src/cli/env_commands.cpp",
    "src/core/install.cpp",
