# PP env profile: ai-data-monorepo
# Edit with: pp env edit ai-data --global
# Used by: pp ai dev (no .envrc in repo)

# GitHub Packages (required to build)
export GH_USER=your-github-username
export GH_TOKEN=ghp_your_github_pat_with_read_packages

# AWS Bedrock (required for chat replies)
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_REGION_KEY_PROPERTY=eu-west-1
# export AWS_SESSION_TOKEN=

# Internal EP APIs (when tools flags are on)
export INTERNAL_WS_USER_USERNAME=
export INTERNAL_WS_USER_PASSWORD=

# Visma Connect / OAuth
export OAUTH_CLIENT_ID=
export OAUTH_CLIENT_SECRET=
export CONNECT_CLIENT_ID=

# RAG vector store (when enable-rag-plus-agent is on)
export VECTOR_STORE_OAUTH2_CLIENT_ID=
export VECTOR_STORE_OAUTH2_CLIENT_SECRET=
export VECTOR_STORE_OAUTH2_TOKEN_URL=

# Defaults - Enterprise Test customer1
export TENANT_FQDN=https://customer1.enterprise-test.visma.no
export ADMIN_API_URL=https://enterprise-test.visma.no/admin
